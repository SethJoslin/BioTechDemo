{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# OpenBioOps Complete Pipeline Walkthrough/n",
    "/n",
    "This notebook demonstrates the full OpenBioOps pipeline using the PBMC 3k dataset from 10x Genomics./n",
    "/n",
    "**Pipeline Steps:**/n",
    "1. Load data from Cell Ranger output/n",
    "2. Compute QC metrics/n",
    "3. Apply quality filters/n",
    "4. Extract features (PCA)/n",
    "5. Generate embeddings using the contrastive encoder/n",
    "6. Visualize with UMAP/n",
    "7. Search for similar runs/n",
    "/n",
    "**Requirements:**/n",
    "- OpenBioOps API running locally (`docker-compose up`)/n",
    "- PBMC 3k dataset (download from 10x Genomics)/n",
    "/n",
    "**Dataset:** [PBMC 3k from 10x Genomics](https://support.10xgenomics.com/single-cell-gene-expression/datasets/1.1.0/pbmc3k)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Install required packages (if needed)/n",
    "# !pip install scanpy pandas requests plotly matplotlib seaborn"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import scanpy as sc/n",
    "import pandas as pd/n",
    "import numpy as np/n",
    "import requests/n",
    "import plotly.express as px/n",
    "import plotly.graph_objects as go/n",
    "from pathlib import Path/n",
    "import json/n",
    "/n",
    "# Configure plotting/n",
    "sc.settings.verbosity = 3/n",
    "sc.settings.set_figure_params(dpi=100, facecolor='white')/n",
    "/n",
    "# API configuration/n",
    "API_BASE_URL = /"http://localhost:8000/v1/"/n",
    "USERNAME = /"demo_user/"/n",
    "/n",
    "print(/" Imports successful/")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 1: Authentication/n",
    "/n",
    "Get a JWT token from the API."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Get authentication token/n",
    "auth_response = requests.post(/n",
    "    f/"{API_BASE_URL}/auth/token/",/n",
    "    json={/"username/": USERNAME}/n",
    ")/n",
    "/n",
    "if auth_response.status_code == 200:/n",
    "    TOKEN = auth_response.json()[/"access_token/"]/n",
    "    HEADERS = {/"Authorization/": f/"Bearer {TOKEN}/"}/n",
    "    print(f/" Authenticated as {USERNAME}/")/n",
    "else:/n",
    "    raise Exception(f/"Authentication failed: {auth_response.text}/")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 2: Load PBMC 3k Data from Cell Ranger/n",
    "/n",
    "We'll use the OpenBioOps Cell Ranger integration to load the data."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from openbioops.processing import parse_cellranger_h5, parse_cellranger_metrics/n",
    "/n",
    "# Path to Cell Ranger output (update this path)/n",
    "cellranger_output = Path(/"/path/to/pbmc3k/filtered_feature_bc_matrix.h5/")/n",
    "/n",
    "# Alternative: Load from 10x website directly/n",
    "if not cellranger_output.exists():/n",
    "    print(/"Downloading PBMC 3k dataset.../")/n",
    "    adata = sc.datasets.pbmc3k()/n",
    "    print(f/" Loaded {adata.n_obs} cells, {adata.n_vars} genes/")/n",
    "else:/n",
    "    # Load from Cell Ranger output/n",
    "    adata = parse_cellranger_h5(cellranger_output)/n",
    "    /n",
    "    # Parse Cell Ranger metrics/n",
    "    metrics = parse_cellranger_metrics(cellranger_output.parent.parent)/n",
    "    print(/"Cell Ranger Metrics:/")/n",
    "    for k, v in metrics.items():/n",
    "        print(f/"  {k}: {v}/")/n",
    "    print(f/"//n Loaded {adata.n_obs} cells, {adata.n_vars} genes/")/n",
    "/n",
    "# Display basic info/n",
    "print(f/"//nData shape: {adata.shape}/")/n",
    "print(f/"Total counts: {adata.X.sum():,.0f}/")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 3: Compute QC Metrics/n",
    "/n",
    "Use OpenBioOps QC module to compute:/n",
    "- Mitochondrial gene percentage/n",
    "- Ribosomal gene percentage/n",
    "- Doublet scores (Scrublet)/n",
    "- Cell complexity metrics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from openbioops.processing import compute_qc_metrics/n",
    "/n",
    "# Compute comprehensive QC metrics/n",
    "qc_metrics = compute_qc_metrics(/n",
    "    adata,/n",
    "    mt_prefix=/"MT-/",/n",
    "    ribo_prefix=/"RPS|RPL/",/n",
    "    detect_doublets=True,/n",
    "    percent_top=[20, 50, 100]/n",
    ")/n",
    "/n",
    "print(/"QC Metrics Summary:/")/n",
    "print(f/"  Median genes per cell: {qc_metrics['median_genes_by_counts']:.0f}/")/n",
    "print(f/"  Median UMIs per cell: {qc_metrics['median_total_counts']:.0f}/")/n",
    "print(f/"  Mean mitochondrial %: {qc_metrics['mean_pct_counts_mt']:.2f}%/")/n",
    "print(f/"  Mean ribosomal %: {qc_metrics['mean_pct_counts_ribo']:.2f}%/")/n",
    "print(f/"  Predicted doublets: {qc_metrics['n_predicted_doublets']} ({qc_metrics['doublet_rate']:.2f}%)/")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualize QC metrics/n",
    "import matplotlib.pyplot as plt/n",
    "import seaborn as sns/n",
    "/n",
    "fig, axes = plt.subplots(2, 3, figsize=(15, 10))/n",
    "/n",
    "# Total counts/n",
    "sc.pl.violin(adata, 'total_counts', ax=axes[0, 0], show=False)/n",
    "axes[0, 0].set_title('Total UMI Counts')/n",
    "/n",
    "# Genes by counts/n",
    "sc.pl.violin(adata, 'n_genes_by_counts', ax=axes[0, 1], show=False)/n",
    "axes[0, 1].set_title('Number of Genes')/n",
    "/n",
    "# Mitochondrial percentage/n",
    "sc.pl.violin(adata, 'pct_counts_mt', ax=axes[0, 2], show=False)/n",
    "axes[0, 2].set_title('Mitochondrial %')/n",
    "/n",
    "# Scatter plots/n",
    "sc.pl.scatter(adata, 'total_counts', 'n_genes_by_counts', ax=axes[1, 0], show=False)/n",
    "sc.pl.scatter(adata, 'total_counts', 'pct_counts_mt', ax=axes[1, 1], show=False)/n",
    "/n",
    "# Doublet scores/n",
    "if 'doublet_score' in adata.obs:/n",
    "    axes[1, 2].hist(adata.obs['doublet_score'], bins=50, edgecolor='black')/n",
    "    axes[1, 2].set_xlabel('Doublet Score')/n",
    "    axes[1, 2].set_ylabel('Frequency')/n",
    "    axes[1, 2].set_title('Doublet Score Distribution')/n",
    "/n",
    "plt.tight_layout()/n",
    "plt.show()/n",
    "/n",
    "print(/" QC visualization complete/")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 4: Apply QC Filters/n",
    "/n",
    "Filter out low-quality cells and doublets."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from openbioops.processing import apply_qc_filters/n",
    "/n",
    "print(f/"Before filtering: {adata.n_obs} cells/")/n",
    "/n",
    "# Apply standard QC filters/n",
    "adata_filtered, filter_stats = apply_qc_filters(/n",
    "    adata,/n",
    "    min_genes=200,/n",
    "    max_genes=5000,/n",
    "    max_pct_mt=20.0,/n",
    "    remove_doublets=True/n",
    ")/n",
    "/n",
    "print(f/"After filtering: {adata_filtered.n_obs} cells/")/n",
    "print(f/"Removed: {filter_stats['n_removed']} cells ({filter_stats['pct_removed']:.2f}%)/")/n",
    "print(f/"//nFilter breakdown:/")/n",
    "print(f/"  Low gene count: {filter_stats['removed_min_genes']}/")/n",
    "print(f/"  High gene count: {filter_stats['removed_max_genes']}/")/n",
    "print(f/"  High mitochondrial: {filter_stats['removed_high_mt']}/")/n",
    "print(f/"  Doublets: {filter_stats['removed_doublets']}/")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 5: Feature Extraction (Preprocessing + PCA)/n",
    "/n",
    "Standard scanpy preprocessing followed by PCA for dimensionality reduction."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Normalize and log-transform/n",
    "sc.pp.normalize_total(adata_filtered, target_sum=1e4)/n",
    "sc.pp.log1p(adata_filtered)/n",
    "/n",
    "# Store raw data for later/n",
    "adata_filtered.raw = adata_filtered.copy()/n",
    "/n",
    "# Identify highly variable genes/n",
    "sc.pp.highly_variable_genes(/n",
    "    adata_filtered,/n",
    "    n_top_genes=2000,/n",
    "    flavor='seurat_v3',/n",
    "    subset=True/n",
    ")/n",
    "/n",
    "print(f/"Selected {adata_filtered.n_vars} highly variable genes/")/n",
    "/n",
    "# Scale and perform PCA/n",
    "sc.pp.scale(adata_filtered, max_value=10)/n",
    "sc.tl.pca(adata_filtered, n_comps=50, svd_solver='arpack')/n",
    "/n",
    "# Visualize variance explained/n",
    "sc.pl.pca_variance_ratio(adata_filtered, n_pcs=50, log=True)/n",
    "/n",
    "print(/" Feature extraction complete/")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 6: Create a Run in OpenBioOps API/n",
    "/n",
    "Register this analysis run in the system."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create a new run/n",
    "run_metadata = {/n",
    "    /"dataset/": /"PBMC 3k/",/n",
    "    /"source/": /"10x Genomics/",/n",
    "    /"n_cells_raw/": int(adata.n_obs),/n",
    "    /"n_cells_filtered/": int(adata_filtered.n_obs),/n",
    "    /"n_genes/": int(adata_filtered.n_vars),/n",
    "    /"pipeline/": /"scanpy_standard/",/n",
    "    /"date/": pd.Timestamp.now().isoformat()/n",
    "}/n",
    "/n",
    "create_response = requests.post(/n",
    "    f/"{API_BASE_URL}/runs/",/n",
    "    json={/n",
    "        /"name/": /"PBMC_3k_demo/",/n",
    "        /"metadata/": run_metadata/n",
    "    },/n",
    "    headers=HEADERS/n",
    ")/n",
    "/n",
    "if create_response.status_code == 201:/n",
    "    run_data = create_response.json()/n",
    "    RUN_ID = run_data[/"id/"]/n",
    "    print(f/" Created run: {RUN_ID}/")/n",
    "    print(f/"   Name: {run_data['name']}/")/n",
    "else:/n",
    "    raise Exception(f/"Failed to create run: {create_response.text}/")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 7: Extract Features for ML Embedding/n",
    "/n",
    "Export PCA features and upload to the API."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Extract PCA features/n",
    "features_df = pd.DataFrame(/n",
    "    adata_filtered.obsm['X_pca'],/n",
    "    index=adata_filtered.obs_names,/n",
    "    columns=[f/"PC{i+1}/" for i in range(50)]/n",
    ")/n",
    "/n",
    "print(f/"Features shape: {features_df.shape}/")/n",
    "print(f/"//nFirst few features:/")/n",
    "print(features_df.head())/n",
    "/n",
    "# Save to artifacts directory for API/n",
    "features_path = Path(/"./artifacts/") / f/"{RUN_ID}.parquet/"/n",
    "features_path.parent.mkdir(exist_ok=True)/n",
    "features_df.to_parquet(features_path)/n",
    "/n",
    "print(f/"//n Features saved to {features_path}/")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 8: Compute Embeddings with Contrastive Encoder/n",
    "/n",
    "Use the OpenBioOps API to compute run-level embeddings."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Trigger embedding computation/n",
    "embedding_response = requests.post(/n",
    "    f/"{API_BASE_URL}/runs/{RUN_ID}/compute_vector/",/n",
    "    headers=HEADERS/n",
    ")/n",
    "/n",
    "if embedding_response.status_code == 202:/n",
    "    task_data = embedding_response.json()/n",
    "    print(f/" Embedding computation started/")/n",
    "    print(f/"   Task ID: {task_data['task_id']}/")/n",
    "    print(f/"   Status: {task_data['status']}/")/n",
    "else:/n",
    "    print(f/"  Embedding computation not available (model not loaded)/")/n",
    "    print(f/"   This is expected in a demo environment/")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 9: Clustering and UMAP Visualization/n",
    "/n",
    "Perform clustering and dimensionality reduction for visualization."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Compute neighborhood graph/n",
    "sc.pp.neighbors(adata_filtered, n_neighbors=15, n_pcs=50)/n",
    "/n",
    "# Leiden clustering/n",
    "sc.tl.leiden(adata_filtered, resolution=0.5)/n",
    "/n",
    "# UMAP/n",
    "sc.tl.umap(adata_filtered)/n",
    "/n",
    "print(f/" Identified {len(adata_filtered.obs['leiden'].unique())} clusters/")/n",
    "/n",
    "# Visualize/n",
    "sc.pl.umap(adata_filtered, color=['leiden'], legend_loc='on data', title='Leiden Clustering')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Interactive UMAP with Plotly/n",
    "umap_df = pd.DataFrame(/n",
    "    adata_filtered.obsm['X_umap'],/n",
    "    columns=['UMAP1', 'UMAP2'],/n",
    "    index=adata_filtered.obs_names/n",
    ")/n",
    "umap_df['cluster'] = adata_filtered.obs['leiden'].values/n",
    "umap_df['n_genes'] = adata_filtered.obs['n_genes_by_counts'].values/n",
    "umap_df['total_counts'] = adata_filtered.obs['total_counts'].values/n",
    "/n",
    "fig = px.scatter(/n",
    "    umap_df,/n",
    "    x='UMAP1',/n",
    "    y='UMAP2',/n",
    "    color='cluster',/n",
    "    hover_data=['n_genes', 'total_counts'],/n",
    "    title='Interactive UMAP - PBMC 3k Clusters',/n",
    "    width=800,/n",
    "    height=600/n",
    ")/n",
    "fig.show()/n",
    "/n",
    "print(/" Interactive visualization complete/")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 10: Save UMAP Coordinates to API/n",
    "/n",
    "Upload UMAP coordinates for the visualization API."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Save UMAP data/n",
    "umap_artifacts_path = Path(/"./artifacts/") / f/"{RUN_ID}_umap.parquet/"/n",
    "umap_df.to_parquet(umap_artifacts_path)/n",
    "/n",
    "print(f/" UMAP data saved to {umap_artifacts_path}/")/n",
    "print(f/"   You can now use the visualization API:/")/n",
    "print(f/"   GET {API_BASE_URL}/viz/{RUN_ID}/umap/")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 11: Marker Gene Analysis/n",
    "/n",
    "Find marker genes for each cluster."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Rank genes for each cluster/n",
    "sc.tl.rank_genes_groups(adata_filtered, groupby='leiden', method='wilcoxon')/n",
    "/n",
    "# Show top marker genes/n",
    "sc.pl.rank_genes_groups(adata_filtered, n_genes=10, sharey=False)/n",
    "/n",
    "# Get marker genes for cluster 0/n",
    "print(/"//nTop marker genes for cluster 0:/")/n",
    "marker_genes = sc.get.rank_genes_groups_df(adata_filtered, group='0')/n",
    "print(marker_genes.head(10))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualize known cell type markers/n",
    "marker_genes_dict = {/n",
    "    'CD4+ T cells': ['IL7R', 'CD4'],/n",
    "    'CD8+ T cells': ['CD8A', 'CD8B'],/n",
    "    'B cells': ['MS4A1', 'CD79A'],/n",
    "    'NK cells': ['NKG7', 'GNLY'],/n",
    "    'Monocytes': ['CD14', 'LYZ'],/n",
    "    'Dendritic cells': ['FCER1A', 'CST3']/n",
    "}/n",
    "/n",
    "all_markers = [gene for genes in marker_genes_dict.values() for gene in genes]/n",
    "available_markers = [g for g in all_markers if g in adata_filtered.raw.var_names]/n",
    "/n",
    "if available_markers:/n",
    "    sc.pl.umap(adata_filtered, color=available_markers[:8], ncols=4, use_raw=True)/n",
    "    print(f/" Visualized {len(available_markers)} marker genes/")/n",
    "else:/n",
    "    print(/"  Marker genes not found in dataset/")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 12: Differential Expression via API/n",
    "/n",
    "Use the OpenBioOps visualization API to compute differential expression between clusters."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Note: This requires the expression data and UMAP data to be in the API's artifacts directory/n",
    "/n",
    "# Compute differential expression between cluster 0 and cluster 1/n",
    "de_response = requests.post(/n",
    "    f/"{API_BASE_URL}/viz/{RUN_ID}/differential/",/n",
    "    params={/"group1/": /"0/", /"group2/": /"1/", /"top_n/": 20},/n",
    "    headers=HEADERS/n",
    ")/n",
    "/n",
    "if de_response.status_code == 200:/n",
    "    de_data = de_response.json()/n",
    "    de_df = pd.DataFrame(de_data[/"genes/"])/n",
    "    /n",
    "    print(f/" Differential expression computed/")/n",
    "    print(f/"   Comparing cluster {de_data['group1']} vs {de_data['group2']}/")/n",
    "    print(f/"   Found {de_data['n_genes']} significant genes//n/")/n",
    "    /n",
    "    print(/"Top differentially expressed genes:/")/n",
    "    print(de_df[['gene', 'log_fold_change', 'adjusted_p_value']].head(10))/n",
    "else:/n",
    "    print(f/"  Differential expression not available: {de_response.status_code}/")/n",
    "    print(/"   (Expression data may not be in the correct location)/")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 13: Search for Similar Runs/n",
    "/n",
    "Use the run embedding to find similar datasets."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Search for similar runs/n",
    "search_response = requests.get(/n",
    "    f/"{API_BASE_URL}/runs/{RUN_ID}/similar/",/n",
    "    params={/"top_k/": 10},/n",
    "    headers=HEADERS/n",
    ")/n",
    "/n",
    "if search_response.status_code == 200:/n",
    "    similar_runs = search_response.json()/n",
    "    /n",
    "    print(f/" Found {len(similar_runs)} similar runs://n/")/n",
    "    /n",
    "    for i, run in enumerate(similar_runs, 1):/n",
    "        print(f/"{i}. {run['name']}/")/n",
    "        print(f/"   Similarity: {run['similarity']:.4f}/")/n",
    "        print(f/"   ID: {run['id']}/")/n",
    "        if 'metadata' in run and run['metadata']:/n",
    "            print(f/"   Metadata: {run['metadata']}/")/n",
    "        print()/n",
    "else:/n",
    "    print(f/"  Similar run search not available/")/n",
    "    print(/"   (Vector index may not be built yet)/")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Step 14: Export Results/n",
    "/n",
    "Save processed data for further analysis."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Save processed AnnData/n",
    "output_path = Path(/"./results/") / f/"{RUN_ID}_processed.h5ad/"/n",
    "output_path.parent.mkdir(exist_ok=True)/n",
    "adata_filtered.write_h5ad(output_path)/n",
    "/n",
    "print(f/" Processed data saved to {output_path}/")/n",
    "/n",
    "# Export cluster assignments/n",
    "cluster_csv = Path(/"./results/") / f/"{RUN_ID}_clusters.csv/"/n",
